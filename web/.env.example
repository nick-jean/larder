# MongoDB Atlas connection string. Without it, DB-backed endpoints return 503.
MONGODB_URI=
MONGODB_DB=larder
# Firebase project used to verify ID tokens.
FIREBASE_PROJECT_ID=
# Local development only: accept "Authorization: Bearer dev:<uid>".
AUTH_DEV_BYPASS=0
# Meta app token with oEmbed Read, for Instagram/Facebook captions (optional; without it users paste captions).
META_OEMBED_TOKEN=
# Opt-in AI tidy-up of pasted text (Gemini, paid tier).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Opt-in cloud OCR for messy handwriting (Google Cloud Vision).
GOOGLE_VISION_API_KEY=
# Rate limits; defaults shown
LINK_IMPORT_PER_MINUTE=20
LINK_IMPORT_PER_DAY=300
AI_PER_MINUTE=5
AI_PER_DAY=30
AI_GLOBAL_PER_DAY=5000
OCR_PER_MINUTE=5
OCR_PER_DAY=30
OCR_GLOBAL_PER_DAY=5000
